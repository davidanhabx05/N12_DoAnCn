# ===== Cấu hình backend (copy thành file .env rồi sửa) =====
# Kết nối PostgreSQL (giống thông tin bạn dùng trong DBeaver)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homnayangi
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Cổng chạy backend
SERVER_PORT=8080

# Key Gemini cho chatbot (Google AI Studio). Để trống -> chatbot trả lời bằng bộ gợi ý offline
GEMINI_API_KEY=

# Key Google Places (tuỳ chọn) để tìm quán thật quanh vị trí người dùng
GOOGLE_PLACES_API_KEY=

# Đường dẫn file service account Firebase (Firebase Console > Project settings > Service accounts)
# Để trống -> đăng nhập Google vẫn chạy khi ALLOW_UNVERIFIED_GOOGLE_TOKEN=true (chỉ nên dùng khi phát triển)
FIREBASE_CREDENTIALS=
ALLOW_UNVERIFIED_GOOGLE_TOKEN=true
