# Địa chỉ backend Spring Boot.
# Để trống: máy ảo Android tự dùng http://10.0.2.2:8080, Web/iOS Simulator dùng http://localhost:8080
# Điện thoại thật: điền IP LAN của máy tính, vd: API_BASE_URL=http://192.168.1.10:8080
API_BASE_URL=

# Key web cua Firebase (Firebase Console > Project settings > Your apps > Web). Chi can khi chay ban Web.
FIREBASE_WEB_API_KEY=
